{
  "name": "cursor-chat-bulk-export",
  "displayName": "Cursor Chat Bulk Export",
  "description": "Export Cursor chat/composer/agent conversations to Markdown files bulk",
  "version": "0.1.3",
  "publisher": "AnasAbbasCode",
  "license": "MIT",
  "author": {
    "name": "Anas Abbas",
    "url": "https://anas-code.com"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anasabbasdev/cursor-chat-bulk-export.git"
  },
  "bugs": {
    "url": "https://github.com/anasabbasdev/cursor-chat-bulk-export/issues"
  },
  "homepage": "https://anas-code.com",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cursor",
    "chat",
    "export",
    "markdown",
    "history"
  ],
  "activationEvents": [
    "onCommand:cursorChatBulkExport.exportCurrentWorkspaceChats"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursorChatExport.exportCurrentWorkspace",
        "title": "Cursor Chat Bulk Export: Export Current Workspace Chats"
      },
      {
        "command": "cursorChatExport.exportAllWorkspaces",
        "title": "Cursor Chat Bulk Export: Export All Detected Workspace Chats"
      },
      {
        "command": "cursorChatExport.openExportFolder",
        "title": "Cursor Chat Bulk Export: Open Export Folder"
      },
      {
        "command": "cursorChatExport.diagnose",
        "title": "Cursor Chat Bulk Export: Diagnose Current Workspace Chat Schema"
      },
      {
        "command": "cursorChatExport.diagnoseDiscovery",
        "title": "Cursor Chat Bulk Export: Diagnose Conversation Discovery"
      },
      {
        "command": "cursorChatExport.rawDiscovery",
        "title": "Cursor Chat Bulk Export: Raw Discovery Mode"
      }
    ],
    "configuration": {
      "title": "Cursor Chat Bulk Export",
      "properties": {
        "cursorChatExport.includePossibleWorkspaceMatches": {
          "type": "boolean",
          "default": true,
          "description": "Match conversations by folder name when the project path changed (recommended for moved projects)."
        },
        "cursorChatExport.cursorUserDataPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to Cursor User folder (e.g. D:\\Cursor\\User from an old PC copy). Overrides default APPDATA path."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node build.js",
    "watch": "node build.js --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@types/sql.js": "^1.4.11",
    "sql.js": "^1.14.1"
  }
}
